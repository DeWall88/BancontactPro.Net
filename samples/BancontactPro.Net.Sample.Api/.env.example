# Copy to .env next to docker-compose.yml, or enter these wherever your container manager keeps environment variables.
# Never commit real values: .env is git-ignored. The README maps Bancontact's email to these.

# --- This app ---
PUBLIC_BASE_URL=https://bancontact-preprod.example.com
SAMPLE_API_PORT=8085
SAMPLE_API_KEY=
BANCONTACT_ENVIRONMENT=Preprod

# --- From Bancontact's email: one pair per product ---
# "A unique API key" -> *_API_KEY, "A unique Product Profile Identifier or PPID" -> *_PPID.
# Take both values of a pair from the same product. Leave products you don't have empty.
BANCONTACT_STATICQR_API_KEY=
BANCONTACT_STATICQR_PPID=
BANCONTACT_ONDISPLAY_API_KEY=
BANCONTACT_ONDISPLAY_PPID=
BANCONTACT_ONRECEIPT_API_KEY=
BANCONTACT_ONRECEIPT_PPID=
BANCONTACT_TOPUP_API_KEY=
BANCONTACT_TOPUP_PPID=
BANCONTACT_INVOICE_API_KEY=
BANCONTACT_INVOICE_PPID=

# --- Your own signing key: only for Refund/Reconciliation. Leave empty for payments. ---
BANCONTACT_KID=
BANCONTACT_PRIVATE_KEY_PEM=
