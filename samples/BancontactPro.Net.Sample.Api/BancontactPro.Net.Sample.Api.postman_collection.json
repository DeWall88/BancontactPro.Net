        },
        {
          "name": "Get payout payments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/v3/reconciliation/payments?page=0&size=20",
            "description": "IReconciliationClient.GetPaymentsAsync → GET /v3/reconciliation/payments. Filter with payoutId, or startDate and endDate."
          },
          "event": [
