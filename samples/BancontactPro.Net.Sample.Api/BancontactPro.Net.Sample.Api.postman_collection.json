{
  "info": {
    "name": "BancontactPro.Net Sample API",
    "description": "Every call of the BancontactPro.Net library, through the sample API (samples/BancontactPro.Net.Sample.Api).\n\nThe sample is a pass-through: each route is Bancontact's own path with the product in front, and calls exactly one library method, which calls exactly one Bancontact endpoint with that product's credentials. Bodies are Bancontact's request and response shapes; errors come back with Bancontact's status, code and trace ID.\n\nCollection variables (collection → Variables):\n- baseUrl: where the sample runs, e.g. http://localhost:8085 or your public HTTPS address.\n- sampleKey: the sample's SAMPLE_API_KEY. Put it in Current value only, so it isn't saved in exports.\n- product: OnDisplay, OnReceipt, StaticQr, TopUp or Invoice. Which product uses which call is in docs/getting-started.md.\n- paymentId / refundId: filled in by the create calls, used by the calls after them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Sample-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{sampleKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "sampleKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "product",
      "value": "OnDisplay",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "refundId",
      "value": "",
      "type": "string"
    },
    {
      "key": "posId",
      "value": "till-1",
      "type": "string"
    },
    {
      "key": "amount",
      "value": "100",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "description": "Liveness. No key needed.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.text() ? pm.response.json() : null;",
              "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{product}}/v3/payments",
            "description": "IPaymentClient.CreateAsync → POST /v3/payments (On Display; see the guide for the other products). Without a callbackUrl the sample points it at itself, so callbacks show up under Callbacks. Valid for 120 seconds: show _links.qrcode (or _links.self) to the payer.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{amount}},\n  \"description\": \"Test payment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }",
                  "if (body && body.paymentId) { pm.collectionVariables.set('paymentId', body.paymentId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payment for a POS (Static QR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{product}}/v3/payments/pos",
            "description": "IPaymentClient.CreateStaticQrPaymentAsync → POST /v3/payments/pos. For Static QR: set product to StaticQr. Create it just before the customer scans the till's sticker (see QR codes); valid for 120 seconds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{amount}},\n  \"description\": \"Test payment\",\n  \"posId\": \"{{posId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }",
                  "if (body && body.paymentId) { pm.collectionVariables.set('paymentId', body.paymentId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}",
            "description": "IPaymentClient.GetAsync → GET /v3/payments/{id}. Use the product the payment was created with."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel payment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}",
            "description": "IPaymentClient.CancelAsync → DELETE /v3/payments/{id}. Only while PENDING (or IDENTIFIED before the payer confirms)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 204', () => pm.expect(pm.response.code).to.be.oneOf([204]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Search payments",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{product}}/v3/payments/search?page=0&size=20",
            "description": "IPaymentClient.SearchAsync → POST /v3/payments/search. All filters are optional; from defaults to yesterday.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentStatuses\": [\"SUCCEEDED\", \"PENDING\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Acknowledge payment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}/acknowledge",
            "description": "IPaymentClient.AcknowledgeAsync → POST /v3/payments/{id}/acknowledge. Only for void-enabled profiles, once the payment is PENDING_MERCHANT_ACKNOWLEDGEMENT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"EUR\",\n  \"amount\": {{amount}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 204', () => pm.expect(pm.response.code).to.be.oneOf([204]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get debtor refund IBAN",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}/debtor/refundIban",
            "description": "IPaymentClient.GetDebtorRefundIbanAsync → GET /v3/payments/{id}/debtor/refundIban."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Refunds (needs a signing key)",
      "item": [
        {
          "name": "Create refund",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}/refunds",
            "description": "IRefundClient.CreateAsync → POST /v3/payments/{id}/refunds, JWS-signed. Needs BancontactPro:Kid and PrivateKeyPem, and the endpoint activated by Bancontact support. Idempotency-Key: a new GUID per send here; reuse one when retrying.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{amount}},\n  \"currency\": \"EUR\",\n  \"description\": \"Test refund\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }",
                  "if (body && body.refundId) { pm.collectionVariables.set('refundId', body.refundId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get refund",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/v3/payments/{{paymentId}}/refunds/{{refundId}}",
            "description": "IRefundClient.GetAsync → GET /v3/payments/{id}/refunds/{refundId}, JWS-signed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reconciliation (needs a signing key)",
      "item": [
        {
          "name": "Get payouts",
          "request": {
