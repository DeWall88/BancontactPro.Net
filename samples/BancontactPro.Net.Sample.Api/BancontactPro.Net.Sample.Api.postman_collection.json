    },
    {
      "name": "Security checks",
      "description": "Requests a public deployment must refuse.",
      "item": [
        {
          "name": "Without the key → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/v3/payments/anything",
            "description": "Every route except /health and the callback needs X-Sample-Key.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 401', () => pm.expect(pm.response.code).to.be.oneOf([401]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsigned callback → 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/bancontact/callback",
            "description": "Only Bancontact can produce a valid Signature header, so a hand-made callback is always rejected.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 401', () => pm.expect(pm.response.code).to.be.oneOf([401]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
