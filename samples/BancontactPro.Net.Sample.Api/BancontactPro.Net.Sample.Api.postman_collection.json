    {
      "name": "Callbacks",
      "item": [
        {
          "name": "Received callbacks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/callbacks?paymentId={{paymentId}}",
            "description": "The last verified callbacks the sample received, newest first. Remove paymentId to see all."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
