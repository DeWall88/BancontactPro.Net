    },
    {
      "name": "QR codes (no API call)",
      "item": [
        {
          "name": "Payment URL (On a Receipt, Top Up, Invoice)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/qr/payment-url?amount={{amount}}&description=Test%20payment&reference=ref-1&format=PNG&size=L",
            "description": "PaymentLinkBuilder.BuildFixedAmountPaymentUrl + BuildQrCodeImageUrl, with the product's PPID. No Bancontact call: the payment ID first appears in the callback. Each amount + description + reference combination must be unique."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
                  "pm.test('status 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 400 && body) { console.log('Error from the sample or Bancontact:', body); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Static QR sticker",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/{{product}}/qr/pos/{{posId}}?format=PNG&size=XL",
            "description": "PaymentLinkBuilder.BuildStaticQrLocationUrl + BuildQrCodeImageUrl: the sticker for one till, printed once. Set product to StaticQr."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.text() ? pm.response.json() : null;",
